{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- $publicPaths := slice "/" "/about/" "/academy/" "/contact/" "/local-projects/" "/myriad/" "/news/" "/news-publishing/" "/privacy/" "/programmes/" "/safeguarding/" "/team/" "/training/" "/trustees/" "/youth/" -}}
  {{- range $publicPaths }}
  <url>
    <loc>{{ . | absURL }}</loc>
  </url>
  {{- end }}
  {{- range where .Site.RegularPages "Type" "post" }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
  </url>
  {{- end }}
</urlset>
